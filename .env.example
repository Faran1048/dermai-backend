# ─────────────────────────────────────────────────────────────────────────────
# DermAI Backend — Environment Variables
# Copy this file to .env and fill in the values before running the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key (server-side only — never expose to the client)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ── HuggingFace ───────────────────────────────────────────────────────────────
# HuggingFace API token for downloading gated models (free at huggingface.co)
HF_API_TOKEN=hf_your_token_here
